# Copy the values you need into your environment (the app reads OS env vars).

# Where the SQLite DB, uploaded evidence and generated PDFs live. Back this folder up.
ELEC_DATA_DIR=./data

# Signs the short-lived file links. Set a long random value in production;
# if unset, a key is generated once and stored in ELEC_DATA_DIR/secret.key.
ELEC_SECRET_KEY=

# If set, the first-run setup screen requires this token (protects an exposed server
# before the first admin exists).
ELEC_SETUP_TOKEN=

# true when served over HTTPS (cookie gets the Secure flag).
ELEC_COOKIE_SECURE=false

ELEC_SESSION_DAYS=14
ELEC_FILE_URL_TTL=600
ELEC_MAX_UPLOAD_MB=50

# Local calendar used for due dates and KPI periods (Korea = 9, no DST).
ELEC_TZ_OFFSET_HOURS=9

# Law / standard items become "검토 필요" this many days after their last check.
ELEC_KNOWLEDGE_REVIEW_DAYS=180

# TrueType font with Hangul for PDF reports. Defaults: Malgun Gothic on Windows,
# NanumGothic on Linux; otherwise a non-embedded CID font is used.
ELEC_PDF_FONT=
